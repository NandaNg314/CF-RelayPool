{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "key-pool-router",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "kv_namespaces": [
    {
      "binding": "KEY_POOL_KV",
      "id": "6122127c8e6c487c9ef69678db332ae3"
    }
  ],
  "triggers": {
    "crons": ["0 0 * * *"]
  },
  "rules": [
    { "type": "Text", "fallthrough": true, "globs": ["src/*.html"] }
  ],
  "observability": {
    "enabled": true
  },
  "workers_dev": true,
  // 提示：自定义域名只需在 Cloudflare Dashboard 绑定一次，或在此取消注释填入自有域名
  // "routes": [
  //   { "pattern": "<你的自定义域名>", "custom_domain": true }
  // ]
}
